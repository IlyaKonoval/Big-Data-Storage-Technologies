@startuml architecture
' UML 2.5 deployment diagram of the CelesTrak data platform (docker-compose), state on 30.10.2026.
' Nodes: «device» = physical machine, «executionEnvironment» = Docker container, named as an
' instance (underlined "name : image"). The second compartment of a node lists what is
' deployed on it (UML textual notation for deployed artifacts and components).
' Communication paths are labelled with the protocol; the arrow points from the client to
' the server. {profile = …} is the docker compose profile of the container (none = always up).
' Rows: user interfaces, background processes, data stores.

!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 80
skinparam ArrowColor #333333
skinparam node {
  BorderColor #333333
  BackgroundColor #FFFFFF
}

title Платформа данных CelesTrak — диаграмма развёртывания (UML 2.5)

node "__Рабочая станция : PC__" <<device>> as ws {
  node browser <<executionEnvironment>> [
    <u>: Веб-браузер</u>
    {graphics = WebGL}
    ----
    «library» globe.gl, satellite.js
    «artifact» страницы глобуса (manifest)
  ]
}

node celestrak <<device>> [
  <u>celestrak.org : Web Server</u>
  {url = https://celestrak.org, повтор до обновления → 403}
  ----
  «dataset» SATCAT, GP, SupGP, SOCRATES
]

node "__Docker-хост : Docker Desktop__" <<device>> as host {

  ' row 1: user interfaces
  node af_api <<executionEnvironment>> [
    <u>airflow-apiserver : bdst-airflow 3.0.6</u>
    {port = 8080}
    ----
    «component» Airflow UI, REST API
  ]
  node superset <<executionEnvironment>> [
    <u>superset : bdst-superset 6.1.0</u>
    {profile = bi, port = 8088}
    ----
    «component» Superset
    «file» superset_config.py
  ]
  node globe <<executionEnvironment>> [
    <u>globe : nginx 1.27.2</u>
    {profile = bi, port = 8090}
    ----
    «file» index.html, chronicle.html, common.js
    «file» nginx.conf (/ch/ → clickhouse)
  ]
  node om <<executionEnvironment>> [
    <u>openmetadata-server : OpenMetadata 1.13.6</u>
    {profile = meta, port = 8585}
    ----
    «component» OpenMetadata Server
  ]

  ' row 2: background processes
  node af_init <<executionEnvironment>> [
    <u>airflow-init : bdst-airflow 3.0.6</u>
    {lifecycle = one-shot}
    ----
    «file» connections.json
  ]
  node af_sched <<executionEnvironment>> [
    <u>airflow-scheduler : bdst-airflow 3.0.6</u>
    {executor = LocalExecutor}
    ----
    «source» dags/*.py
    «library» plugins/celestrak/
    «script» sql/vault, sql/dq, sql/mart
  ]
  node ss_boot <<executionEnvironment>> [
    <u>superset-bootstrap : bdst-superset 6.1.0</u>
    {profile = bi, lifecycle = one-shot}
    ----
    «script» bootstrap.py
  ]
  node om_ing <<executionEnvironment>> [
    <u>om-ingest : ingestion-base 1.13.6</u>
    {profile = meta, schedule = 1 h}
    ----
    «file» workflows/*.yaml, catalog.yaml
    «script» ingest.py, catalog.py, quality.py
  ]

  ' row 3: data stores
  node dwh_pg <<executionEnvironment>> [
    <u>dwh-postgres : PostgreSQL 16.4</u>
    {profile = archive}
    ----
    «database» dwh
  ]
  node mysql <<executionEnvironment>> [
    <u>mysql : MySQL 8.4.3</u>
    {profile = archive}
    ----
    «database» ods
  ]
  node seaweed <<executionEnvironment>> [
    <u>seaweedfs : SeaweedFS 3.80</u>
    {port = 8333}
    ----
    «bucket» raw/<source>/dt=…/
  ]
  node ch <<executionEnvironment>> [
    <u>clickhouse : ClickHouse 24.8</u>
    {port = 8123}
    ----
    «schema» ods, stage, rv, bv, mart, meta
  ]
  node pg <<executionEnvironment>> [
    <u>airflow-postgres : PostgreSQL 16.4</u>
    {port = 5432}
    ----
    «database» airflow, superset, openmetadata_db
  ]
  node es <<executionEnvironment>> [
    <u>om-elasticsearch : Elasticsearch 9.3.0</u>
    {profile = meta, port = 9200}
    ----
    «index» поисковые индексы
  ]
}

' --- communication paths (client --> server) -----------------------------------------------
browser --> af_api : «HTTP» :8080
browser --> superset : «HTTP» :8088
browser --> globe : «HTTP» :8090\n(iframe дашборда)
browser --> om : «HTTP» :8585

af_api --> pg : «TCP» :5432
af_init --> pg : «TCP» :5432
af_sched -left-> celestrak : «HTTPS» :443
af_sched --> dwh_pg : «TCP» :5432\n(postgres_dwh)
af_sched --> mysql : «TCP» :3306\n(mysql_ods)
af_sched --> seaweed : «S3 API» :8333\n(s3_raw)
af_sched --> ch : «HTTP» :8123\n(clickhouse_dwh)
af_sched --> pg : «TCP» :5432
af_sched -up-> om : «HTTP REST» :8585\n(openmetadata)

superset --> ch : «HTTP» :8123\nuser superset
superset --> pg : «TCP» :5432
ss_boot -up-> superset : «HTTP REST» :8088
globe --> ch : «HTTP» :8123\nuser superset

om --> pg : «TCP» :5432
om --> es : «HTTP» :9200
om_ing -up-> om : «HTTP REST» :8585
om_ing --> ch : «HTTP» :8123
om_ing --> seaweed : «S3 API» :8333
om_ing --> pg : «TCP» :5432\n(метаданные Superset)

' column order inside each row
af_api -[hidden]right-> superset
superset -[hidden]right-> globe
globe -[hidden]right-> om
af_init -[hidden]right-> af_sched
af_sched -[hidden]right-> ss_boot
ss_boot -[hidden]right-> om_ing
dwh_pg -[hidden]right-> mysql
mysql -[hidden]right-> seaweed
seaweed -[hidden]right-> ch
ch -[hidden]right-> pg
pg -[hidden]right-> es

legend right
  |= Нотация |= Значение |
  | «device» | физическая машина |
  | «executionEnvironment» | контейнер Docker: __имя : образ__ |
  | отдел под чертой | развёрнутые в узле компоненты и артефакты |
  | стрелка | коммуникационный путь, от клиента к серверу |
  | (имя) у пути | Airflow Connection, через которое идёт обращение |
  | {profile = …} | профиль docker compose; без профиля — всегда запущен |
  Не показаны одноразовые контейнеры миграций superset-init, om-migrate,
  om-db-init, а также airflow-dag-processor, airflow-triggerer и airflow-cli
  (тот же образ Airflow, подключаются только к airflow-postgres).
endlegend

@enduml
